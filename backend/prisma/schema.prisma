generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(DOCTOR)
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  appointments Appointment[]
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  phone       String?
  dateOfBirth DateTime
  gender      String?
  address     String?
  bloodType   String?
  allergies   String?
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(uuid())
  dateTime  DateTime
  status    AppointmentStatus @default(SCHEDULED)
  reason    String?
  notes     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
  
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}
