generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  PROFESSIONAL
  ASSISTANT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships  Membership[]
  sessions     Session[]
  auditEvents  AuditEvent[]
}

model Clinic {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  timezone  String       @default("America/Mexico_City")
  status    ClinicStatus @default(ACTIVE)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships    Membership[]
  activeSessions Session[]
  auditEvents    AuditEvent[]
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  clinicId  String           @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profile   ProfessionalProfile?

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
}

model ProfessionalProfile {
  id                  String     @id @default(uuid()) @db.Uuid
  membershipId        String     @unique @db.Uuid
  specialtyCode       String
  professionalLicense String?
  active              Boolean    @default(true)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  membership          Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  activeClinicId String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime  @default(now())
  ipAddress      String?
  userAgent      String?

  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeClinic   Clinic?   @relation(fields: [activeClinicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeClinicId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  clinicId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  success     Boolean  @default(true)
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clinicId])
  @@index([actorUserId])
}
